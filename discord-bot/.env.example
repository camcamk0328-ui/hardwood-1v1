# Bot token from https://discord.com/developers/applications (Bot tab)
DISCORD_TOKEN=

# Application (client) ID from the General Information tab
CLIENT_ID=

# Your server ID (right click server with Developer Mode on -> Copy Server ID)
GUILD_ID=

# Role to ping for game night and VC pings (right click role -> Copy Role ID).
# Leave empty to ping @everyone.
PING_ROLE_ID=

# Optional: channel where game night pings are posted. Leave empty to use the channel the command was run in.
GAME_NIGHT_CHANNEL_ID=

# Optional: channel where VC pings are posted. Leave empty to use the channel the command was run in.
VC_PING_CHANNEL_ID=
